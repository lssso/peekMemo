<Window x:Class="PeekMemo.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PeekMemo 설정"
        Width="370"
        Height="550"
        MinWidth="370"
        MinHeight="550"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterOwner">

    <Window.Resources>
        <Style x:Key="ColorChipRadioStyle" TargetType="RadioButton">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                        x:Name="ChipBorder"
                        Width="32"
                        Height="32"
                        CornerRadius="16"
                        BorderThickness="2"
                        BorderBrush="Transparent"
                        Background="Transparent">
                            <ContentPresenter
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ChipBorder" Property="BorderBrush" Value="#FF333333"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CleanComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="8,0"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#FFBDBDBD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style
    x:Key="OptionButtonStyle"
    TargetType="RadioButton">

            <Setter Property="Height" Value="38"/>
            <Setter Property="FontWeight" Value="SemiBold"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">

                        <Border
                    x:Name="Border"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="#FFE5E5E5"
                    Background="#FFF8F8F8">

                            <ContentPresenter
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsChecked" Value="True">
                                <Setter
                            TargetName="Border"
                            Property="Background"
                            Value="#FFFFD54F"/>

                                <Setter
                            TargetName="Border"
                            Property="BorderBrush"
                            Value="#FFE0B300"/>
                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="4"/>
            <Setter Property="MinWidth" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid
                            Width="{TemplateBinding Width}"
                            Background="Transparent">

                            <Track
                        x:Name="PART_Track"
                         Width="{TemplateBinding Width}"
                        IsDirectionReversed="True">

                                <Track.Thumb>
                                    <Thumb
                                Width="{TemplateBinding Width}"
                                Background="#FFD0D0D0">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border
                                            Width="{TemplateBinding Width}"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="3"/>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="White" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Text="PeekMemo 설정"
                       FontSize="22"
                       FontWeight="Bold"
                       Foreground="#333333"
                       Margin="0 0 0 18"/>
             
                <Border Grid.Row="1"
                    Background="#FFFFFF"
                    BorderBrush="#FFF5F5F5"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="6"
                    Margin="0 0 0 18">

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SettingsTabButton"
                            Content="설정"
                            Height="34"
                            Width="70"
                            Margin="0 0 6 0"
                            Background="#FFF5F5F5"
                            BorderBrush="#FFE5E5E5"
                            BorderThickness="1"
                            FontWeight="Bold"
                            Click="SettingsTabButton_Click"/>

                    <Button x:Name="IndexTabButton1"
                            Content="업무"
                            Height="34"
                            Width="70"
                            Margin="0 0 6 0"
                            Background="#FFFFFF"
                            BorderThickness="0"
                            Click="IndexTabButton1_Click"/>

                    <Button x:Name="IndexTabButton2"
                            Content="개인"
                            Height="34"
                            Width="70"
                            Margin="0 0 6 0"
                            Background="#FFFFFF"
                            BorderThickness="0"
                            Click="IndexTabButton2_Click"/>

                    <Button x:Name="AddIndexButton"
                            Content="+"
                            Height="34"
                            Width="70"
                            Background="#FFFFFF"
                            BorderThickness="0"
                            FontSize="14"
                            Click="AddIndexButton_Click"/>
                </StackPanel>
            </Border>
            
            <Grid Grid.Row="2">
                <ScrollViewer
                    VerticalScrollBarVisibility="Auto"
                    Padding="0,0,4,0"
                    HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                    <StackPanel x:Name="AppSettingsPanel">
                    <TextBlock
                    Text="열기 방식"
                    FontWeight="SemiBold"
                    Margin="0,0,0,6"/>

                                    <UniformGrid
                    Columns="2"
                    Margin="0,0,0,15">

                                        <RadioButton
                        x:Name="OpenModeHoverRadio"
                        Content="마우스오버"
                        Checked="SettingValue_Changed"
                        GroupName="OpenMode"
                        Style="{StaticResource OptionButtonStyle}"/>

                                        <RadioButton
                        x:Name="OpenModeClickRadio"
                        Content="클릭"
                        GroupName="OpenMode"
                        Checked="SettingValue_Changed"
                        Margin="6,0,0,0"
                        Style="{StaticResource OptionButtonStyle}"/>
                                    </UniformGrid>

                    <TextBlock Text="인덱스 길이" FontWeight="SemiBold" Margin="0 0 0 6"/>

                    <UniformGrid Columns="3" Margin="0 0 0 18">
                            <RadioButton x:Name="IndexLengthShortRadio"
                     Content="짧게"
                     GroupName="IndexLength"
                     Checked="SettingValue_Changed"
                     Style="{StaticResource OptionButtonStyle}"/>

                            <RadioButton x:Name="IndexLengthMediumRadio"
                     Content="중간"
                     GroupName="IndexLength"
                     Margin="6,0,0,0"
                     Checked="SettingValue_Changed"
                     Style="{StaticResource OptionButtonStyle}"/>

                            <RadioButton x:Name="IndexLengthLongRadio"
                     Content="길게"
                     GroupName="IndexLength"
                     Margin="6,0,0,0"
                     Checked="SettingValue_Changed"
                     Style="{StaticResource OptionButtonStyle}"/>
                        </UniformGrid>

                    <TextBlock Text="표시 위치" FontWeight="SemiBold" Margin="0 0 0 6"/>

                    <UniformGrid Columns="2" Margin="0 0 0 18">
                            <RadioButton x:Name="EdgeLeftRadio"
                     Content="좌측"
                     GroupName="Edge"
                     Checked="SettingValue_Changed"
                     Style="{StaticResource OptionButtonStyle}"/>

                            <RadioButton x:Name="EdgeRightRadio"
                     Content="우측"
                     GroupName="Edge"
                     Margin="6,0,0,0"
                     Checked="SettingValue_Changed"
                     Style="{StaticResource OptionButtonStyle}"/>
                        </UniformGrid>

                    <TextBlock Text="세로 위치" FontWeight="SemiBold" Margin="0 0 0 6"/>

                    <UniformGrid Columns="3" Margin="0 0 0 18">
                        <RadioButton x:Name="AlignmentTopRadio"
                         Content="상단"
                         GroupName="Alignment"
                         Checked="SettingValue_Changed"
                         Style="{StaticResource OptionButtonStyle}"/>

                                <RadioButton x:Name="AlignmentCenterRadio"
                         Content="중간"
                         GroupName="Alignment"
                         Margin="6,0,0,0"
                         Checked="SettingValue_Changed"
                         Style="{StaticResource OptionButtonStyle}"/>

                                <RadioButton x:Name="AlignmentBottomRadio"
                         Content="하단"
                         GroupName="Alignment"
                         Margin="6,0,0,0"
                         Checked="SettingValue_Changed"
                         Style="{StaticResource OptionButtonStyle}"/>
                            </UniformGrid>

                            <TextBlock Text="모니터"
                               FontWeight="SemiBold"
                               Margin="0 0 0 6"/>

                                                <UniformGrid Columns="3"
                                 Margin="0 0 0 18">

                                                    <RadioButton x:Name="MonitorPrimaryRadio"
                                     Content="주 모니터"
                                     GroupName="Monitor"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource OptionButtonStyle}"/>

                                                    <RadioButton x:Name="MonitorSub1Radio"
                                     Content="보조 1"
                                     GroupName="Monitor"
                                     Margin="6,0,0,0"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource OptionButtonStyle}"/>

                                                    <RadioButton x:Name="MonitorSub2Radio"
                                     Content="보조 2"
                                     GroupName="Monitor"
                                     Margin="6,0,0,0"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource OptionButtonStyle}"/>
                                                </UniformGrid>
                        
                            <TextBlock
                        Text="저장 위치"
                        Margin="0,0,0,6"
                        FontWeight="SemiBold"/>

                    <Border
                        Background="#FFF8F8F8"
                        BorderBrush="#FFEAEAEA"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0,0,0,18">

                                            <Grid>

                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <TextBlock
                                Grid.Row="0"
                                Grid.Column="0"
                                Text="📁 저장 위치"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center"/>

                            <Button
                                x:Name="ChangeDataFolderButton"
                                Grid.Row="0"
                                Grid.Column="1"
                                Content="📂 변경"
                                Width="82"
                                Height="30"
                                Background="#FFFFFFFF"
                                BorderBrush="#FFBDBDBD"
                                BorderThickness="1"
                                Foreground="#333333"
                                FontWeight="SemiBold"
                                Cursor="Hand"
                                Click="ChangeDataFolderButton_Click"/>

                            <TextBlock
                                x:Name="DataFolderTextBlock"
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Margin="0,8,0,0"
                                TextWrapping="Wrap"
                                Foreground="#666666"/>

                                            </Grid>

                                        </Border>



                    <CheckBox
                        x:Name="StartWithWindowsCheckBox"
                        Content="Windows 시작 시 자동 실행"
                        Margin="0 0 0 18"
                        Checked="SettingValue_Changed"
                        Unchecked="SettingValue_Changed"/>

                    <Button
                        x:Name="ResetAppSettingsButton"
                        Content="기본값으로 초기화"
                        Height="34"
                        Background="#FFF5F5F5"
                        BorderThickness="0"
                        Foreground="#555555"
                        FontWeight="SemiBold"
                        Click="ResetAppSettingsButton_Click"/>
                </StackPanel>
                    </Grid>
                </ScrollViewer>
                <StackPanel x:Name="IndexSettingsPanel"
                            Visibility="Collapsed">
                    <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                                        <TextBlock
                        Text="제목"
                        FontWeight="SemiBold" />

                                        <TextBlock
                        x:Name="HotKeyInfoTextBlock"
                        Grid.Column="1"
                        Text="Ctrl+Shift+1"
                        FontSize="12"
                        Foreground="#888888"
                        VerticalAlignment="Center" />
                                    </Grid>

                    <TextBox x:Name="TitleTextBox"
                             MaxLength="6"
                             Height="30"
                             Text="업무"
                             Margin="0 0 0 18"
                             VerticalContentAlignment="Center"
                             TextChanged="SettingValue_Changed"/>

                    
                    <TextBlock Text="인덱스 색상" Margin="0 0 0 8"/>

                    <StackPanel x:Name="ColorPanel"
                                Orientation="Horizontal"
                                Margin="0 0 0 22">

                        <RadioButton GroupName="MemoColor"
                                     Tag="#FFFFD54F"
                                     Margin="0 0 12 0"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource ColorChipRadioStyle}">
                            <Ellipse Width="24" Height="24" Fill="#FFFFD54F"/>
                        </RadioButton>

                        <RadioButton GroupName="MemoColor"
                                     Tag="#FFF8BBD0"
                                     Margin="0 0 12 0"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource ColorChipRadioStyle}">
                            <Ellipse Width="24" Height="24" Fill="#FFF8BBD0"/>
                        </RadioButton>

                        <RadioButton GroupName="MemoColor"
                                     Tag="#FFC8E6C9"
                                     Margin="0 0 12 0"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource ColorChipRadioStyle}">
                            <Ellipse Width="24" Height="24" Fill="#FFC8E6C9"/>
                        </RadioButton>

                        <RadioButton GroupName="MemoColor"
                                     Tag="#FFBBDEFB"
                                     Margin="0 0 12 0"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource ColorChipRadioStyle}">
                            <Ellipse Width="24" Height="24" Fill="#FFBBDEFB"/>
                        </RadioButton>

                        <RadioButton GroupName="MemoColor"
                                     Tag="#FFD1C4E9"
                                     Checked="SettingValue_Changed"
                                     Style="{StaticResource ColorChipRadioStyle}">
                            <Ellipse Width="24" Height="24" Fill="#FFD1C4E9"/>
                        </RadioButton>
                    </StackPanel>
                    <Button
                        Content="인덱스 삭제"
                        Height="34"
                        Background="#FFFFE5E5"
                        BorderThickness="0"
                        Foreground="#CC3333"
                        FontWeight="Bold"
                        Click="DeleteIndexButton_Click"/>
                </StackPanel>
                    
            </Grid>

            <Border Grid.Row="3"
                    Background="#FFF3F3F3"
                    CornerRadius="12"
                    Padding="6"
                    Margin="0 20 0 0">

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Content="저장"
                            Height="40"
                            Background="#FFFFD54F"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="SaveButton_Click"/>

                    <Button Grid.Column="2"
                            Content="닫기"
                            Height="40"
                            Background="White"
                            BorderThickness="0"
                            Click="CloseButton_Click"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>