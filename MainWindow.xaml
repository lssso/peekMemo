<Window x:Class="PeekMemo.MainWindow"
        ShowInTaskbar="False"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PeekMemo"
        Height="520"
        Width="400"
        MinHeight="520"
        MinWidth="300"
        Topmost="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_KeyDown"
        Deactivated="Window_Deactivated"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">
    
    <Window.Resources>
        <Style x:Key="ToolbarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="14"/>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22000000"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>


    <Grid Background="Transparent"
      MouseEnter="Window_MouseEnter"
      MouseLeave="Window_MouseLeave"
      MouseLeftButtonDown="Window_MouseLeftButtonDown">

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftColumn" Width="32"/>
            <ColumnDefinition x:Name="RightColumn" Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid
    Grid.Column="1"
    x:Name="MemoBodyContainer">

            <Border
        x:Name="MemoBodyBorder"
        Grid.Row="0"
        Background="#FFF8BBD0"
        CornerRadius="0 20 20 0"
        Padding="15">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0 0 0 10">
                        <StackPanel
                            Orientation="Horizontal"
                            HorizontalAlignment="Right">

                                                <Button
                                x:Name="PinButton"
                                Content="📌"
                                FontSize="15"
                                Foreground="#555555"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="PinButton_Click"/>

                                                <Button
                                x:Name="HideToTrayButton"
                               Content="🙈"
                                FontSize="15"
                                Foreground="#555555"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Click="HideToTrayButton_Click"/>

                                                <Button
                               Content="⚙"
                                FontSize="15"
                                Foreground="#555555"
                                Style="{StaticResource ToolbarButtonStyle}"
                                Margin="0"
                                Click="SettingsButton_Click"/>
                                            </StackPanel>
                                        </Grid>

                                <Border
                                    x:Name="SearchPanel"
                                    Grid.Row="1"
                                    Background="#FFF5F5F5"
                                    BorderBrush="#DDDDDD"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="6"
                                    Visibility="Collapsed"
                                    VerticalAlignment="Top"
                                    Margin="0,0,0,8">

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="26" />
                            </Grid.ColumnDefinitions>

                            <TextBox
                                x:Name="SearchTextBox"
                                Grid.Column="0"
                                Height="24"
                                Margin="0,0,8,0"
                                VerticalContentAlignment="Center"
                                Padding="4,0"
                                TextChanged="SearchTextBox_TextChanged"/>

                                                    <TextBlock
                                x:Name="SearchResultText"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                FontSize="11"
                                Foreground="#777777"
                                VerticalAlignment="Center"
                                Text="0 / 0"/>

                                                    <Button
                                x:Name="PreviousSearchButton"
                                Grid.Column="2"
                                Focusable="False"
                                Content="▲"
                                Width="22"
                                Height="22"
                                Margin="0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Click="PreviousSearchButton_Click"/>

                                                    <Button
                                x:Name="NextSearchButton"
                                Grid.Column="3"
                                Focusable="False"
                                Content="▼"
                                Width="22"
                                Height="22"
                                Margin="2,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Click="NextSearchButton_Click"/>

                                                    <Button
                                x:Name="CloseSearchButton"
                                Grid.Column="4"
                                Focusable="False"
                                Content="✕"
                                FontSize="13"
                                Background="Transparent"
                                BorderBrush="#CCCCCC"
                                BorderThickness="1"
                                Width="22"
                                Height="22"
                                Margin="4,0,0,0"
                                Padding="0"
                                Click="CloseSearchButton_Click"/>
                                                </Grid>
                    </Border>

                                <TextBox
                            x:Name="MemoTextBox"
                            Grid.Row="2"
                            FontSize="15"
                            TextWrapping="Wrap"
                            AcceptsReturn="True"
                            VerticalScrollBarVisibility="Auto"
                            Background="#FFFFF8E1"
                            Foreground="#333333"
                            BorderThickness="0"
                            Padding="10"
                            TextChanged="MemoTextBox_TextChanged"
                            SelectionBrush="#FF90CAF9"
                            SelectionOpacity="0.6"
                            IsInactiveSelectionHighlightEnabled="True"
                            PreviewMouseLeftButtonDown="MemoTextBox_PreviewMouseLeftButtonDown"/>

                    <Grid Grid.Row="3" Margin="0 8 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock
                        Text="PeekMemo v1.0.0"
                        FontSize="11"
                        Foreground="#777777"
                        VerticalAlignment="Center"/>

                                        <TextBlock
                        x:Name="SaveStatusText"
                        Grid.Column="1"
                        Text="아직 저장되지 않음"
                        FontSize="11"
                        Foreground="#777777"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"/>
                                    </Grid>

                </Grid>
            </Border>

            <Border
                x:Name="ResizeBar"
                Height="10"
                VerticalAlignment="Bottom"
                Background="Transparent"
                Cursor="SizeNS"
                MouseLeftButtonDown="ResizeBar_MouseLeftButtonDown"
                MouseMove="ResizeBar_MouseMove"
                MouseLeftButtonUp="ResizeBar_MouseLeftButtonUp"/>
        </Grid>

        <StackPanel Grid.Column="0" VerticalAlignment="Center" x:Name="MemoTabsPanel">

            <Border
        x:Name="MemoTabBorder1"
        Width="32"
        Height="120"
        Background="#FFFFD54F"
        CornerRadius="20 0 0 20"
        Margin="0 0 0 8"
        MouseLeftButtonDown="MemoTab1_MouseLeftButtonDown">

                <TextBlock
            x:Name="MemoTabText1"
            Text="업무"
            FontSize="14"
            FontWeight="Bold"
            Foreground="#333333"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>

            <Border
        x:Name="MemoTabBorder2"
        Width="32"
        Height="120"
        Background="#FFF8BBD0"
        CornerRadius="20 0 0 20"
        MouseLeftButtonDown="MemoTab2_MouseLeftButtonDown">

                <TextBlock
            x:Name="MemoTabText2"
            Text="개인"
            FontSize="14"
            FontWeight="Bold"
            Foreground="#333333"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="0.5,0.5">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>

            <Border
            x:Name="MemoTabBorder3"
            Width="32"
            Height="120"
            Background="#FFBBDEFB"
            CornerRadius="18 0 0 18"
            Margin="0 8 0 0"
            MouseLeftButtonDown="MemoTab3_MouseLeftButtonDown">

                        <TextBlock
                x:Name="MemoTabText3"
                Text="공부"
                FontSize="14"
                FontWeight="Bold"
                Foreground="#333333"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

        </StackPanel>

    </Grid>
</Window>
